      "dur": 4.835,
      "sub_end": 5.73,
      "lines": [
        "القرآن نزّل آية كاملة تعفيه من الحرب..",
        "بس هو رفض يقعد في البيت!"
      ],
      "wav": "out/voice/L01.wav"
    },
    {
      "id": "L02",
      "shot": 2,
      "t0": 5.835,
      "t1": 9.686,
      "dur": 3.851,
      "sub_end": 9.84,
      "lines": [
        "في غزوة أُحد، كان في صحابي",
        "اسمه عمرو بن الجموح.."
      ],
      "wav": "out/voice/L02.wav"
    },
    {
      "id": "L03",
      "shot": 2,
      "t0": 9.906,
      "t1": 15.394,
      "dur": 5.488,
      "sub_end": 15.59,
      "lines": [
        "راجل كبير في السن، وعنده عرج شديد جداً",
        "في رجله بيخليه يمشي بصعوبة بالغة."
      ],
      "wav": "out/voice/L03.wav"
    },
    {
      "id": "L04",
      "shot": 3,
      "t0": 15.674,
      "t1": 21.888,
      "dur": 6.214,
      "sub_end": 22.098,
      "lines": [
        "وكان عنده 4 أولاد شباب زي الأسود،",
        "كلهم خارجين يحاربوا مع النبي ﷺ."
      ],
      "wav": "out/voice/L04.wav"
    },
    {
      "id": "L05a",
      "shot": 4,
      "t0": 22.188,
      "t1": 26.58,
      "dur": 4.392,
      "sub_end": 26.692,
      "lines": [
        "أولاده منعوه يخرج وقالوا له:",
        "يا أبانا، الله عذرك.."
      ],
      "wav": "out/voice/L05a.wav"
    },
    {
      "id": "L05b",
      "shot": 4,
      "t0": 26.74,
      "t1": 31.293,
      "dur": 4.553,
      "sub_end": 31.573,
      "lines": [
        "ونزلت فيك آية ﴿لَيْسَ عَلَى الْأَعْرَجِ حَرَجٌ﴾،",
        "إحنا بنكفيك!"
      ],
      "wav": "out/voice/L05b.wav"
    },
    {
      "id": "L06",
      "shot": 5,
      "t0": 31.693,
      "t1": 36.481,
      "dur": 4.788,
      "sub_end": 36.775,
      "lines": [
        "لكن عمرو غضب وراح يشتكي للنبي ﷺ",
        "وقال كلمة تهز الجبال:"
      ],
      "wav": "out/voice/L06.wav"
    },
    {
      "id": "L07",
      "shot": 5,
      "t0": 36.901,
      "t1": 40.809,
      "dur": 3.908,
      "sub_end": 40.935,
      "lines": [
        "يا رسول الله، إن بنيّ يريدون",
        "أن يحبسوني عن هذا الوجه.."
      ],
      "wav": "out/voice/L07.wav"
    },
    {
      "id": "L08",
      "shot": 5,
      "t0": 40.989,
      "t1": 44.111,
      "dur": 3.122,
      "sub_end": 44.431,
      "lines": [
        "والله إني لأرجو أن أطأ",
        "بعرجتي هذه في الجنة!"
      ],
      "wav": "out/voice/L08.wav"
    },
    {
      "id": "L09",
      "shot": 6,
      "t0": 44.761,
      "t1": 51.342,
      "dur": 6.581,
      "sub_end": 51.662,
      "lines": [
        "النبي ﷺ بصّ لأولاده وقالهم:",
        "«دعوه، لعل الله أن يرزقه الشهادة»."
      ],
      "wav": "out/voice/L09.wav"
    },
    {
      "id": "L10",
      "shot": 7,
      "t0": 52.022,
      "t1": 57.557,
      "dur": 5.535,
      "sub_end": 57.669,
      "lines": [
        "وفعلاً.. نزل عمرو بن الجموح أرض المعركة بسيفه،",
        "وهو بيعرج وسط السيوف والرماح،"
      ],
      "wav": "out/voice/L10.wav"
    },
    {
      "id": "L11",
      "shot": 7,
      "t0": 57.717,
      "t1": 60.591,
      "dur": 2.874,
      "sub_end": 60.911,
      "lines": [
        "وقاتل بشجاعة لحد ما استشهد",
        "في سبيل الله."
      ],
      "wav": "out/voice/L11.wav"
    },
    {
      "id": "L12",
      "shot": 8,
      "t0": 61.371,
      "t1": 69.859,
      "dur": 8.488,
      "sub_end": 70.179,
      "lines": [
        "وبعد المعركة، مرّ النبي ﷺ على جثمانه وقال:",
        "«كأني أنظر إليك تمشي برجلك هذه صحيحة في الجنة»."
      ],
      "wav": "out/voice/L12.wav"
    },
    {
      "id": "L13",
      "shot": 8,
      "t0": 70.439,
      "t1": 74.614,
      "dur": 4.175,
      "sub_end": 74.908,
      "lines": [
        "الأعذار بتصنعها العقول..",
        "أما الهمم فبتصنعها القلوب."
      ],
      "wav": "out/voice/L13.wav"
    },
    {
      "id": "L14",
      "shot": 8,
      "t0": 75.034,
      "t1": 79.158,
      "dur": 4.124,
      "sub_end": 79.478,
      "lines": [
        "لو القصة لمست قلبك،",
        "شاركها عشان غيرك يعرفها."
      ],
      "wav": "out/voice/L14.wav"
    }
  ]
